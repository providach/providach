# Configure all three for branded team notifications and sender acknowledgements.
RESEND_API_KEY=
CONSULTATION_FROM=Providach Limited <info@providachltd.com>
CONSULTATION_TO=info@providachltd.com
# Optional alternative for a private server with persistent storage.
# Storage mode saves submissions only; it does not send acknowledgement emails.
CONSULTATION_STORAGE_DIR=

# Verified public contact details; blank values are omitted from the page.
PROVIDACH_PUBLIC_EMAIL=
PROVIDACH_PUBLIC_PHONE=
PROVIDACH_PUBLIC_WHATSAPP=
PROVIDACH_PUBLIC_ADDRESS=
PROVIDACH_PUBLIC_MAPS_URL=

# Optional Google Search Console HTML verification token (not a secret).
GOOGLE_SITE_VERIFICATION=
