# Configure all three values for production email delivery via Resend.
RESEND_API_KEY=
CONSULTATION_FROM=
CONSULTATION_TO=
# Optional alternative: absolute private persistent storage directory.
# Without email or storage configured, submissions return an honest unavailable error.
CONSULTATION_STORAGE_DIR=

# Verified PUBLIC company details. Leave blank to omit each channel from the page.
# Configure before building the site. These values are intentionally shown publicly.
PROVIDACH_PUBLIC_EMAIL=
PROVIDACH_PUBLIC_PHONE=
PROVIDACH_PUBLIC_WHATSAPP=
PROVIDACH_PUBLIC_ADDRESS=
PROVIDACH_PUBLIC_MAPS_URL=
